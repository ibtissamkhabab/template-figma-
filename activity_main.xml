<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#674DEE">

    <!-- Header Section (30% of screen) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_weight="3"
        android:padding="10dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <!-- Edit Button -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:contentDescription="Edit"
            android:padding="8dp"
            android:src="@drawable/ic_edit" />

        <!-- Date Text -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp"
            android:text="20 December 2022"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Flight Route Container -->
        <LinearLayout
            android:id="@+id/flightRouteContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDate"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- DEL Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOriginCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="DEL"
                    android:textColor="#ffffff"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOriginName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:text="Delhi International Airport"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Flight Icon and Dashed Line -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">

                <!-- Orange Dot (Left) -->
                <View
                    android:id="@+id/dotLeft"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/orange_dot" />

                <!-- Dashed Line (Left) -->
                <View
                    android:id="@+id/dashedLineLeft"
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/dotLeft"
                    android:background="@drawable/dashed_line"
                    android:layerType="software" />

                <!-- Plane Icon -->
                <ImageView
                    android:id="@+id/ivPlane"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/dashedLineLeft"
                    android:contentDescription="Flight"
                    android:src="@drawable/ic_plane" />

                <!-- Dashed Line (Right) -->
                <View
                    android:id="@+id/dashedLineRight"
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ivPlane"
                    android:background="@drawable/dashed_line"
                    android:layerType="software" />

                <!-- Arrow Icon (Right) -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/dashedLineRight"
                    android:contentDescription="Arrow"/>
            </RelativeLayout>

            <!-- BLR Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDestinationCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="BLR"
                    android:textColor="#ffffff"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDestinationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:text="Bengaluru Airport India"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flight Duration -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/flightRouteContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            android:text="04h 30m"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Passenger Info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDuration"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Passenger"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/tvPassengers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Adult"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

    <!-- RecyclerView Section (70% of screen) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFlights"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:background="#f5f5f5"
        android:clipToPadding="false"
        android:padding="16dp" />

</LinearLayout>