<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Airline Logo and Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivAirlineLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/z"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/tvAirlineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Indigo"
                android:textSize="18sp"
                android:textColor="#1E293B"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Flight Details Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Départ Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDepartureCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEL"
                    android:textSize="18sp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDepartureTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:30"
                    android:textSize="16sp"
                    android:textColor="#1E293B"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Durée Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="04h 15m"
                    android:textSize="20sp"
                    android:textColor="#6C19D8"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvFlightType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Non-stop"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"/>
            </LinearLayout>

            <!-- Arrivée Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvArrivalCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLR"
                    android:textSize="18sp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvArrivalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:45"
                    android:textSize="16sp"
                    android:textColor="#1E293B"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Prix Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivPriceIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/tag"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7,319"
                    android:textSize="20sp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>


        <TextView
            android:id="@+id/tvCashback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Use Code : flyaway10 and get 60% instant cashback"
            android:textSize="14sp"
            android:textColor="#00CD46"
            android:gravity="end"
            android:padding="6dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>